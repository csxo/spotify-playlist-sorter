{
  "manifest_version": 3,
  "name": "Spotify Playlist Auto Sorter (歌单智能重排器)",
  "version": "1.0.0",
  "author": "csxo (https://github.com/csxo/spotify-playlist-sorter)",
  "homepage_url": "https://github.com/csxo/spotify-playlist-sorter",
  "description": "Auto sort Spotify playlists by artist grouping, track count descending, A-Z/year, single tracks sunk, feat attribution, deduplication and 1-click copy.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://open.spotify.com/*",
    "https://developer.spotify.com/*",
    "https://accounts.spotify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spotify Playlist Auto Sorter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://developer.spotify.com/*"
      ],
      "js": [
        "developer-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}